# Python virtual environments
venv/
.venv/
.env

# Python caches and bytecode
__pycache__/
*.pyc

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# macOS / Windows file system cruft
.DS_Store
Thumbs.db

# Raw NHS downloads: large (~1 GB) and fully regenerated by the cleaning
# script, so they are not tracked. The folder itself is kept via .gitkeep.
data/raw/*
!data/raw/.gitkeep
*.xlsx
*.zip
